# --- Gateway ---
GATEWAY_PORT=8080
PII_SERVICE_URL=http://pii-service:8001
GUARDRAILS_SERVICE_URL=http://guardrails-service:8002
MODERATION_SERVICE_URL=http://moderation-service:8003
REDTEAM_SERVICE_URL=http://redteam-service:8004
# Kommagetrennte Origins für CORS
CORS_ORIGINS=http://localhost:3000

# Gemeinsamer Zugangsschutz für Frontend und Gateway (mindestens 12 Zeichen)
SITE_PASSWORD=change-this-before-deploying

# --- Frontend ---
# Vom Browser aus erreichbare Gateway-URL
NUXT_PUBLIC_API_BASE=http://localhost:8080

# --- PII-Service ---
# Unterstützte Sprachen für Presidio (spaCy-Modelle müssen installiert sein)
PII_LANGUAGES=en,de
# Google Cloud DLP (Engine "gcp-dlp"; zusätzlich google-cloud-dlp in requirements.txt aktivieren)
#GCP_PROJECT_ID=
#GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-credentials.json
# AWS Comprehend (Engine "aws-comprehend"; zusätzlich boto3 in requirements.txt aktivieren)
#AWS_REGION=eu-central-1
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# --- Guardrails-Service ---
# Default-Engine: heuristic | llm-guard | guardrails-ai | nemo-guardrails | openai-guardrails | lakera
GUARDRAILS_ENGINE=heuristic
#LAKERA_GUARD_API_KEY=
#NEMO_CONFIG_PATH=/app/nemo-config

# --- Moderation-Service (Llama Guard via Ollama) ---
# Lokales Ollama vom Container aus: http://host.docker.internal:11434
# Vorher: ollama pull llama-guard3
#OLLAMA_URL=http://host.docker.internal:11434
MODERATION_MODEL=llama-guard3

# --- Orchestrator / LLM-Provider (Playground, Promptfoo, Garak, OpenAI Guardrails) ---
# Ollama lokal: OLLAMA_URL oben setzen – wird auch vom Orchestrator genutzt
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
