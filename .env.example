# --- Gateway ---
GATEWAY_PORT=8080
PII_SERVICE_URL=http://pii-service:8001
GUARDRAILS_SERVICE_URL=http://guardrails-service:8002
# Kommagetrennte Origins für CORS
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
# Vom Browser aus erreichbare Gateway-URL
NUXT_PUBLIC_API_BASE=http://localhost:8080

# --- PII-Service ---
# Unterstützte Sprachen (spaCy-Modelle müssen installiert sein)
PII_LANGUAGES=en,de

# --- Guardrails-Service ---
# "heuristic" (leichtgewichtig, sofort lauffähig) oder "llm-guard" (ML-Modelle, größer)
GUARDRAILS_ENGINE=heuristic
